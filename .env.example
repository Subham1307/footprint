# Supabase — required for admin portal & live content
# Create a project at https://supabase.com and run supabase/migrations/20260319000000_initial_footprint_schema.sql

# Project URL only — do NOT add /rest/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Legacy anon key OR new publishable key (Dashboard → API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only: seed + export (service_role OR secret key — never in the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# After first Auth signup, add your user in SQL:
# insert into public.admin_users (user_id, email)
# values ('<auth.users uuid>', 'you@example.com');
# Public origin for canonical URLs, sitemap and social previews (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
